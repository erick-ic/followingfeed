# 本地开发示例：复制为 .env 后按需调整。
# 该文件仅为占位，不可用于生产。
FOLLOWINGFEED_MYSQL_PASSWORD=passw0rd!
FOLLOWINGFEED_JWT_ACCESS_TOKEN_KEY=local-development-access-token-key-change-before-production
FOLLOWINGFEED_JWT_REFRESH_TOKEN_KEY=local-development-refresh-token-key-change-before-production

# 仅在隔离的性能测试环境中临时调高，生产环境应按容量和风险评估设置。
FOLLOWINGFEED_RATE_LIMIT_WINDOW=1s
FOLLOWINGFEED_RATE_LIMIT_THRESHOLD=100
